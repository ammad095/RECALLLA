# ============================================================
# Recalla backend — environment variables
# Copy to .env and fill in:   cp .env.example .env
# ============================================================

# ── REQUIRED: Groq LLM (summarization, agent chat, email drafting) ───────────
# Free key from https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── OPTIONAL: Google Calendar + Gmail integration ────────────────────────────
# Leave blank to run without calendar/email tools.
# To populate these, run:  python setup_google_oauth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# From developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User token (never expires). NOT the 24-hour temporary one.
WHATSAPP_ACCESS_TOKEN=
# App Settings → Basic → App Secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# A string you invent; must match what you type into Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=recalla_KtFaMS07lY3MoAYLuXo9gnQGIN0ov3Y6

# Your reserved ngrok static domain, e.g. recalla-fyp.ngrok-free.app
# Free: one per account at dashboard.ngrok.com -> Domains.
NGROK_DOMAIN=
